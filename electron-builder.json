{
  "productName": "EVA",
  "appId": "cn.macnova.eva",

  "afterPack": "./build/afterPackHook.js",
  "afterSign": "./build/afterSignHook.js",

  "asar": true,

  "directories": {
    "output": "release"
  },

  "files": [
    "dist/electron/**/*"
  ],

  "fileAssociations": [
    {
      "ext": "torrent",
      "mimeType": "application/x-bittorrent",
      "name": "Torrent",
      "role": "Viewer"
    }
  ],

  "protocols": [
    {
      "name": "EVA Protocol",
      "schemes": [
        "eva"
      ]
    },
    {
      "name": "Magnet Protocol",
      "schemes": [
        "magnet"
      ]
    },
    {
      "name": "Thunder Protocol",
      "schemes": [
        "thunder"
      ]
    }
  ],

  "dmg": {
    "background": "build/dmg-background@2x.png",
    "iconSize": 72,

    "window": {
      "width": 600,
      "height": 400
    },

    "contents": [
      {
        "x": 180,
        "y": 147,
        "type": "file"
      },
      {
        "x": 420,
        "y": 147,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },

  "mac": {
    "extendInfo": {
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "EVA",
          "CFBundleURLSchemes": [
            "eva"
          ]
        }
      ]
    },

    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64",
          "universal"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64",
          "universal"
        ]
      }
    ],

    "type": "distribution",

    "darkModeSupport": true,

    "hardenedRuntime": false,

    "notarize": false,

    "extraResources": {
      "from": "./extra/darwin/${arch}/",
      "to": "./",
      "filter": [
        "**/*"
      ]
    },

    "category": "public.app-category.internet"
  },

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],

    "icon": "build/icon.ico",

    "publisherName": "MacNova",

    "requestedExecutionLevel": "asInvoker",

    "extraResources": {
      "from": "./extra/win/",
      "to": "./",
      "filter": [
        "**/*"
      ]
    }
  },

  "nsis": {
    "oneClick": false,

    "allowToChangeInstallationDirectory": true,

    "perMachine": false,

    "createDesktopShortcut": true,

    "createStartMenuShortcut": true,

    "shortcutName": "EVA",

    "artifactName": "${productName}-Setup-${version}.${ext}",

    "installerIcon": "build/icon.ico",

    "uninstallerIcon": "build/icon.ico",

    "installerHeaderIcon": "build/icon.ico",

    "deleteAppDataOnUninstall": false
  }
}
