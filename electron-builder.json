{
  "productName": "EVA",
  "appId": "cn.macnova.eva",

  "afterPack": "./build/afterPackHook.js",
  "afterSign": "./build/afterSignHook.js",

  "asar": true,

  "directories": {
    "output": "release"
  },

  "files": [
    "dist/electron/**/*"
  ],

  "fileAssociations": [
    {
      "ext": "torrent",
      "mimeType": "application/x-bittorrent",
      "name": "Torrent",
      "role": "Viewer"
    }
  ],

  "protocols": [
    {
      "name": "EVA Protocol",
      "schemes": [
        "eva"
      ]
    },
    {
      "name": "Magnet Protocol",
      "schemes": [
        "magnet"
      ]
    },
    {
      "name": "Thunder Protocol",
      "schemes": [
        "thunder"
      ]
    }
  ],

  "dmg": {
    "background": "build/dmg-background@2x.png",
    "iconSize": 72,

    "window": {
      "width": 600,
      "height": 400
    },

    "contents": [
      {
        "x": 180,
        "y": 147,
        "type": "file"
      },
      {
        "x": 420,
        "y": 147,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },

  "mac": {
    "extendInfo": {
      "CFBundleURLTypes": [
        {
          "CFBundleURLName": "EVA",
          "CFBundleURLSchemes": [
            "eva"
          ]
        }
      ]
    },

    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64",
          "universal"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64",
          "universal"
        ]
      }
    ],

    "type": "distribution",

    "darkModeSupport": true,

    "hardenedRuntime": false,

    "notarize": false,

    "extraResources": {
      "from": "./extra/darwin/${arch}/",
      "to": "./",
      "filter": [
        "**/*"
      ]
    },

    "category": "public.app-category.internet"
  },

  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64", "ia32"] },
      { "target": "zip", "arch": ["x64", "ia32"] },
      { "target": "portable", "arch": ["x64", "ia32"] }
    ],
    "extraResources": {
      "from": "./extra/win32/${arch}/",
      "to": "./",
      "filter": ["**/*"]
    },
    "asarUnpack": ["**/*.dll", "**/node_modules/**/*"]
  },

  "nsis": {
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
